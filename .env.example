# Postgres (used by docker compose, extract.py and dbt)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=change_me
DB_NAME=lp_analytics

# Only needed for a live extraction. The committed snapshot runs without it.
# Base mainnet RPC, for example https://base-mainnet.g.alchemy.com/v2/<your-key>
RPC_URL=

# Airflow (only for docker-compose.airflow.yml)
# On Linux set AIRFLOW_UID to the output of `id -u` so files Airflow writes stay yours.
AIRFLOW_UID=1000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
